{
  "name": "vbfa-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "VBFA website: Astro frontend on Vercel, Sanity content, Supabase leads.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/finalize-vercel-output.mjs",
    "check": "astro check",
    "test": "vitest run",
    "verify": "npm run check && npm test && npm run build && python3 scripts/check_site.py",
    "fonts": "node scripts/build-fonts.mjs",
    "seed:export": "node scripts/export-seed.mjs",
    "studio:install": "npm --prefix studio install",
    "qa:serve": "node scripts/qa/serve.mjs 4322",
    "qa:e2e": "node scripts/qa/e2e.mjs http://localhost:4322"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.16",
    "@sanity/client": "^8.10.1",
    "@sanity/image-url": "^2.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "astro": "^7.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^24.0.0",
    "playwright": "^1.56.1",
    "subset-font": "^2.4.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
