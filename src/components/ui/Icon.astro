---
/** Inline icon set (viewBox 24, stroke currentColor, round caps/joins) — hand-drawn per the handoff. */
export type IconName =
  | 'arrow' | 'arrow-left' | 'arrow-right' | 'arrow-down' | 'arrow-up' | 'search' | 'menu' | 'close' | 'check' | 'chevron'
  | 'calendar' | 'clock' | 'sprout' | 'link' | 'mail' | 'scales' | 'chart' | 'flask' | 'book' | 'globe' | 'document';

interface Props {
  name: IconName;
  size?: number;
  /** stroke-width */
  sw?: number;
  class?: string;
}
const { name, size = 18, sw = 2, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  arrow: 'M7 17L17 7M8 7h9v9',
  'arrow-left': 'M20 12H4M10 6l-6 6 6 6',
  'arrow-right': 'M4 12h16M14 6l6 6-6 6',
  'arrow-down': 'M12 4v16M6 14l6 6 6-6',
  'arrow-up': 'M12 20V4M6 10l6-6 6 6',
  search: 'M16 16l4.5 4.5',
  menu: 'M4 7h16M4 12h16M4 17h10',
  close: 'M6 6l12 12M18 6L6 18',
  check: 'M5 12.5l4.5 4.5L19 7.5',
  chevron: 'M9 5l7 7-7 7',
  calendar: 'M3.5 10h17M8 3v4M16 3v4',
  clock: 'M12 7.5V12l3 2',
  sprout: 'M12 21v-9M12 12c0-4.2-3-6.5-7.5-6.5 0 4.2 3 6.5 7.5 6.5zM12 14c0-3.6 2.6-6 7-6 0 3.6-2.6 6-7 6z',
  link: 'M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1',
  mail: 'M3.5 7l8.5 6 8.5-6',
  scales: 'M12 4v16M8 20h8M4 7h16M6.5 7l-3 7a3 3 0 0 0 6 0l-3-7zM17.5 7l-3 7a3 3 0 0 0 6 0l-3-7z',
  chart: 'M3 3v18h18M7 15l4-4 3 3 6-7M16 7h4v4',
  flask: 'M9 3h6M10 3v6l-5.2 9.2A2 2 0 0 0 6.5 21h11a2 2 0 0 0 1.7-2.8L14 9V3M7.6 15h8.8',
  book: 'M12 6.5C10.2 5 7.2 4.5 4 4.5v13c3.2 0 6.2.5 8 2 1.8-1.5 4.8-2 8-2v-13c-3.2 0-6.2.5-8 2zM12 6.5v13',
  globe: 'M3 12a9 9 0 1 0 18 0 9 9 0 1 0-18 0M3 12h18M12 3c2.8 2.6 4 5.6 4 9s-1.2 6.4-4 9c-2.8-2.6-4-5.6-4-9s1.2-6.4 4-9z',
  document: 'M7 3h7l4 4v14H7zM14 3v4h4M10 12h5M10 16h5',
};
---
<svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'search' && <circle cx="11" cy="11" r="6.5" />}
  {name === 'calendar' && <rect x="3.5" y="5" width="17" height="15.5" rx="2" />}
  {name === 'clock' && <circle cx="12" cy="12" r="8.5" />}
  {name === 'mail' && <rect x="3" y="5.5" width="18" height="13" rx="2" />}
  <path d={paths[name]} />
</svg>
