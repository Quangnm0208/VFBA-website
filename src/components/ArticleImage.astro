---
interface Props {node:{assetUrl?:string,alt?:string}}
const {node}=Astro.props;
const url=node?.assetUrl?node.assetUrl+'?auto=format&w=1200&q=85':'';
---
{url&&<figure class="article-inline-image"><img src={url} alt={node.alt||'Minh hoạ nội dung bài viết'} loading="lazy" decoding="async" width="1200"/></figure>}
<style>
.article-inline-image{margin:32px 0}
.article-inline-image img{width:100%;height:auto;border-radius:10px}
</style>
