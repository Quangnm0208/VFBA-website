---
import { DEFAULT_OG, indexingEnabled, serializeJsonLd } from '~/lib/seo';
import { absoluteUrl } from '~/lib/url';
import type { Media, Seo } from '~/lib/content';

interface Props {
  /** Page-level defaults; CMS `seo` fields override them. */
  title: string;
  description: string;
  path: string;
  seo?: Seo;
  type?: 'website' | 'article';
  image?: Media;
  publishedAt?: string;
  modifiedAt?: string;
  siteName: string;
  jsonLd?: Array<Record<string, unknown>>;
}
const { title, description, path, seo, type = 'website', image, publishedAt, modifiedAt, siteName, jsonLd = [] } = Astro.props;

const finalTitle = seo?.title || title;
const finalDescription = seo?.description || description;
const canonical = seo?.canonicalUrl || absoluteUrl(path);
const noindex = !indexingEnabled() || Boolean(seo?.noIndex);
const og = seo?.ogImage ?? image;
const ogUrl = og ? absoluteUrl(og.src) : absoluteUrl(DEFAULT_OG.path);
---
<title>{finalTitle}</title>
<meta name="description" content={finalDescription} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1'} />
<meta name="theme-color" content="#0b2616" />
<meta property="og:locale" content="vi_VN" />
<meta property="og:site_name" content={siteName} />
<meta property="og:type" content={type} />
<meta property="og:title" content={finalTitle} />
<meta property="og:description" content={finalDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
{og ? <meta property="og:image:alt" content={og.alt} /> : <><meta property="og:image:width" content={String(DEFAULT_OG.width)} /><meta property="og:image:height" content={String(DEFAULT_OG.height)} /></>}
{type === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt} />}
{type === 'article' && modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={finalTitle} />
<meta name="twitter:description" content={finalDescription} />
<meta name="twitter:image" content={ogUrl} />
{jsonLd.map((data) => <script type="application/ld+json" set:html={serializeJsonLd(data)} />)}
