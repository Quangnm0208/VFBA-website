# Website: public Sanity dataset only; content editors log in at Sanity Studio.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-03-01
# Supabase lead database: use a VBFA-owned project. NEVER expose secret to browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile; required for actual form submission.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Studio (separately deployable)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
