# ───────── Website (Vercel project → Settings → Environment Variables) ─────────
# Canonical origin for canonical URLs / OG / sitemap. Leave empty on previews.
PUBLIC_SITE_URL=
# "off" blocks crawlers (meta robots + robots.txt). Set to "on" ONLY for the production launch.
PUBLIC_SITE_INDEXING=off

# Sanity Content Lake (read at build time). Leave empty to build from the local seed content.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-10-01
# Only for a private dataset; never prefix with PUBLIC_.
SANITY_API_READ_TOKEN=

# ───────── Vercel Functions only (src/pages/api/**) ─────────
# Supabase project owned by VBFA. The service-role key bypasses RLS: server only, never in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Random string used to hash visitor addresses for rate limiting (openssl rand -hex 32). REQUIRED: without it the forms answer 503.
IP_HASH_SALT=
# Go-live switch for collecting personal data. Set to "true" ONLY after the privacy policy and consent text are approved.
LEADS_ENABLED=
# Cloudflare Turnstile: BOTH keys are mandatory whenever LEADS_ENABLED=true.\n# Missing site key or secret -> forms return HTTP 503; do not use testing keys in production.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Extra origins allowed to POST to /api/* (comma separated), e.g. the custom domain during cut-over.
FORM_ALLOWED_ORIGINS=

# ───────── Tooling ─────────
# "true" enables Vercel Web Analytics (cookieless) and nothing else.
ENABLE_VERCEL_ANALYTICS=false

# Sanity Studio (studio/.env) - hosted by Sanity, see studio/README.md
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
